---
import Layout from '../layouts/Layout.astro';
import { BrowseTree } from '../components/BrowseTree.jsx';
---

<Layout 
  title="அதிகாரங்கள் | Browse Chapters — Thirukkural" 
  description="Browse all 133 chapters of Thirukkural sorted hierarchically by Section (Paal) and Subsection (Iyal)."
  breadcrumbs={[{ label: "அதிகாரங்கள் (Browse)" }]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <h1 class="font-serif-tamil text-3xl font-bold tracking-tight text-ink-bg dark:text-paper-bg" id="browse-title">
        அதிகாரங்களை ஆராய்க
      </h1>
      <p class="text-sm text-ink-bg/60 dark:text-paper-bg/60" id="browse-subtitle">
        முப்பாலையும் அதன் இயல் மற்றும் அதிகாரங்களின் படி பிரித்து ஆராயும் கட்டமைப்பு.
      </p>
    </div>
    
    <!-- Render the React island BrowseTree client-side -->
    <BrowseTree client:load />
  </div>

  <script>
    import { initLangSync } from '../scripts/langSync.js';

    document.addEventListener('astro:page-load', () => {
      if (!document.getElementById('browse-title')) return;

      const browseBindings = [
        { elementId: 'browse-title', ta: "அதிகாரங்களை ஆராய்க", en: "Browse Chapters" },
        { elementId: 'browse-subtitle', ta: "முப்பாலையும் அதன் இயல் மற்றும் அதிகாரங்களின் படி பிரித்து ஆராயும் கட்டமைப்பு.", en: "Explore the structure of Thirukkural divided by the three Books (Paal) and Sections (Iyal)." }
      ];

      initLangSync(browseBindings);
    });
  </script>
</Layout>
